      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "As Of Date",
          "type": "string"
        },
        "rule_version": {
          "const": "branch-rules.v1",
