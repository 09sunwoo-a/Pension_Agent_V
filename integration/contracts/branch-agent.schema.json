      "required": [
        "schema_version",
        "request_id",
        "conversation_id",
        "base_revision",
        "code",
        "retryable",
        "message"
      ],
      "title": "ErrorData",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/ErrorData"
