          "type": "string"
        }
      },
      "required": [
        "event",
        "data"
      ],
      "title": "AnswerEvent",
      "type": "object"
    },
    "BooleanPredicate": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Compare"
              },
              {
                "$ref": "#/$defs/Segment"
              },
              {
                "$ref": "#/$defs/IsaBetween"
              },
              {
                "$ref": "#/$defs/BooleanPredicate"
              },
              {
                "$ref": "#/$defs/NotPredicate"
              }
            ]
