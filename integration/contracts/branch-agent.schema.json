          "maxItems": 32,
          "minItems": 1,
          "title": "Args",
          "type": "array"
        },
        "op": {
          "enum": [
            "and",
            "or"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "BooleanPredicate",
      "type": "object"
    },
    "BranchRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimpleAction"
            },
            {
              "$ref": "#/$defs/RemoveAction"
            },
            {
              "$ref": "#/$defs/BriefAction"
            },
            {
              "$ref": "#/$defs/ClarifyAction"
            },
