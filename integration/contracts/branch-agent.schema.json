      "required": [
        "schema_version",
        "request_id",
        "conversation_id",
        "base_revision",
        "dataset_id",
        "data_version",
        "rule_version",
        "task",
        "x_client_user",
        "message",
        "action",
        "state"
      ],
      "title": "BranchRequest",
      "type": "object"
    },
    "BriefAction": {
      "additionalProperties": false,
