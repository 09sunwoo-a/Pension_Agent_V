          "minItems": 1,
          "title": "Metric Keys",
          "type": "array"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        }
      },
      "required": [
        "selection",
        "metric_keys"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Button"
          },
          "maxItems": 8,
          "title": "Actions",
          "type": "array"
        },
        "base_revision": {
          "exclusiveMaximum": 9007199254740991,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Base Revision",
          "type": "integer"
        },
        "context_label": {
          "maxLength": 2000,
          "title": "Context Label",
          "type": "string"
