            {
              "const": "invalid-request",
              "type": "string"
            }
          ],
          "title": "Request Id"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "branch-agent-api.v1",
          "title": "Schema Version",
          "type": "string"
        }
