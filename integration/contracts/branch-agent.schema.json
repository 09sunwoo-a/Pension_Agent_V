            {
              "type": "null"
            }
          ],
          "title": "Field"
        },
        "kind": {
          "enum": [
            "cash_field",
            "cash_value",
            "amount_basis",
            "scope",
            "customer",
            "date_basis",
            "condition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 48,
          "title": "Options",
          "type": "array"
        },
        "pending_message": {
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Pending Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "pending_message",
        "candidate_row_ids",
        "options"
