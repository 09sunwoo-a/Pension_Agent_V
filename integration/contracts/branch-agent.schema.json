    "Choice": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
