        "task": {
          "const": "branch_assistant",
          "title": "Task",
          "type": "string"
        },
        "x_client_user": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "X Client User",
          "type": "string"
        }
