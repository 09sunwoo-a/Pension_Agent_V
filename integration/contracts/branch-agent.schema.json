      },
      "required": [
        "op",
        "start",
        "end"
      ],
      "title": "IsaBetween",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "customer_count",
            "irp_sum",
            "cash_sum"
          ],
