    "Filter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "$ref": "#/$defs/IsaBetween"
            },
            {
              "$ref": "#/$defs/BooleanPredicate"
            },
            {
              "$ref": "#/$defs/NotPredicate"
            }
          ],
          "title": "Predicate"
        },
        "type": {
          "const": "filter",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
