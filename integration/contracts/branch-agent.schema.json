        "arg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "$ref": "#/$defs/Segment"
            },
            {
              "$ref": "#/$defs/IsaBetween"
            },
            {
              "$ref": "#/$defs/BooleanPredicate"
            },
            {
              "$ref": "#/$defs/NotPredicate"
            }
          ],
          "title": "Arg"
        },
        "op": {
          "const": "not",
