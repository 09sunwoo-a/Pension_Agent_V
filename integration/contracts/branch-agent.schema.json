      "title": "Choice",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "candidate_row_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "type": "string"
          },
          "maxItems": 48,
          "title": "Candidate Row Ids",
          "type": "array"
