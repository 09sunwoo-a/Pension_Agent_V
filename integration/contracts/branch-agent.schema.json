        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimpleAction"
            },
            {
              "$ref": "#/$defs/RemoveAction"
            },
            {
              "$ref": "#/$defs/BriefAction"
            },
            {
              "$ref": "#/$defs/ClarifyAction"
            }
          ],
          "title": "Action"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "action"
      ],
