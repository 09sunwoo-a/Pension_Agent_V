# ============================================================
# Agent 환경변수 (이름만. 실제 값은 절대 커밋하지 않는다.)
# 실제 .env 는 사내 GitLab 배포 repo에만 두고 Dockerfile이 COPY 한다.
#   COPY ./.env /custom/.env
# ============================================================

# ------------------------------------------------------------
# Stage
# Jenkins가 --build-arg ENV_FILE_PATH=<training|serving> 로 주입하고
# Dockerfile이 ENV ENV_PATH=$ENV_FILE_PATH 로 넘긴다.
#   "serving" | "serv" → SERV
#   그 외 / 미설정      → TRNN (기본)
# ------------------------------------------------------------
ENV_PATH=

# ------------------------------------------------------------
# Gemma4 (사내 GenAI APIM)
#
# ⚠️ BASE_URL 의 마지막 path(gemma-4)와 DEPLOYMENT_NAME 은 다른 값이다.
#    DEPLOYMENT_NAME 을 endpoint path로 추측하지 마라.
#    실제: gemma-4-31b-nvidia-fp4-h100
# ------------------------------------------------------------
LLM_BASE_URL_TRNN=
LLM_BASE_URL_SERV=

# 🔒 Secret
LLM_API_KEY_TRNN=
LLM_API_KEY_SERV=

LLM_MODEL=
LLM_API_VERSION=

# 미설정 시 llm_client.py 의 DEFAULT_DEPLOYMENT_NAME 사용
# LLM_DEPLOYMENT_NAME=

LLM_CLIENT_USER_SPREAD=
LLM_MAX_RETRIES=
LLM_TIMEOUT=
